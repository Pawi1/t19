<Window x:Class="zad1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:zad1"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        Title="Kalkulator" Height="450" Width="800">
    <Grid Margin="150">
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Button Margin="10" x:Name="dodawanieButton" Content="Dodawanie" Click="dodawanieButton_Click"/>
        <Button Margin="10" x:Name="odejmowanieButton" Content="Odejmowanie" Grid.Column="1" Click="odejmowanieButton_Click"/>
        <Button Margin="10" x:Name="mnozenieButton" Content="Mnożenie" Grid.Row="1" Click="mnozenieButton_Click"/>
        <Button Margin="10" x:Name="dzielenieButton" Content="Dzielenie" Grid.Row="1" Grid.Column="1" Click="dzielenieButton_Click"/>
    </Grid>
</Window>
