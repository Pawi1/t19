<Window x:Class="zad2.GeometriaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:zad2"
        mc:Ignorable="d"
        Title="GeometriaWindow" Height="450" Width="780">
    <Grid Margin="230 120">
    <Grid.ColumnDefinitions>
        <ColumnDefinition/>
        <ColumnDefinition/>
    </Grid.ColumnDefinitions>
        <Button Margin="10"  Click="Button_Click">
            <StackPanel>
                <Image Source="/img/kolo2.png" />
                <TextBlock Text="Oblicz pole koła" TextAlignment="Center"/>
            </StackPanel>
        </Button>
        <Button Margin="10" Grid.Column="1" Click="Button_Click_1">
            <StackPanel>
                <Image Source="/img/prostokat.png" />
                <TextBlock Text="Oblicz pole prostokąta" TextAlignment="Center"/>
            </StackPanel>
        </Button>
    </Grid>
</Window>
