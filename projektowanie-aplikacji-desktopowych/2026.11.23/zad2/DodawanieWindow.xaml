<Window x:Class="zad1.DodawanieWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:zad1"
        mc:Ignorable="d"
        WindowStartupLocation="CenterOwner"
        Title="Kalkulator" Height="450" Width="800">
    <Grid>
        <StackPanel Margin="200 50 200 50" Orientation="Vertical">
            <TextBlock Text="Liczba a:" />
            <TextBox x:Name="liczbaA" Margin="5"/>
            <TextBlock Text="Liczba b:" />
            <TextBox x:Name="liczbaB" Margin="5"/>
            <Button x:Name="obliczButton" Margin="20" Content="Oblicz sume" Click="obliczButton_Click"/>
            <TextBlock x:Name="wynik" FontSize="30" FontWeight="Bold" TextAlignment="Center"/>
        </StackPanel>
    </Grid>
</Window>
