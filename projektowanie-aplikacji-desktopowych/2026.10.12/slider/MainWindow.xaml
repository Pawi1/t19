<Window x:Class="slider.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:slider"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="2*"/>
        </Grid.RowDefinitions>
    
    <StackPanel>
        <Label>Intesywność koloru czerwonego (R)</Label>
        <Slider
            ValueChanged="slider_r_ValueChanged"
            x:Name="slider_r"
            Value="128"
            Minimum="0"
            Maximum="255"
            TickFrequency="1"
            IsSnapToTickEnabled="True"/>
        <Label>Intesywność koloru zielonego (G)</Label>
        <Slider
    ValueChanged="slider_r_ValueChanged"
    x:Name="slider_g"
    Value="128"
    Minimum="0"
    Maximum="255"
    TickFrequency="1"
    IsSnapToTickEnabled="True"/>
        <Label>Intesywność koloru niebieskiego (B)</Label>
        <Slider
    ValueChanged="slider_r_ValueChanged"
    x:Name="slider_b"
    Value="128"
    Minimum="0"
    Maximum="255"
    TickFrequency="1"
    IsSnapToTickEnabled="True"/>
    </StackPanel>
        <Border Grid.Row="1" x:Name="area"
                BorderBrush="Gray"
                Background="Gray"
                BorderThickness="1">
            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" x:Name="colour" />
        </Border>
    </Grid>
</Window>
