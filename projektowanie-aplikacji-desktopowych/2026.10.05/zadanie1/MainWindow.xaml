<Window x:Class="zadanie1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:zadanie1"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <StackPanel>
        <GroupBox Header="Wybierz figure" Margin="10">
            <StackPanel Orientation="Horizontal">
                <RadioButton Checked="wyswietl_Checked" x:Name="kolo" Content="kolo" Margin="5" IsChecked="True"/>
                <RadioButton Checked="wyswietl_Checked" x:Name="prostokat" Content="prostokat" Margin="5"/>
                <RadioButton Checked="wyswietl_Checked" x:Name="trojkat" Content="trojkat" Margin="5"/>
            </StackPanel>
        </GroupBox>
        
        <Border BorderBrush="Black" BorderThickness="1" HorizontalAlignment="Left">
            <Image x:Name="figura" Source="/obrazy/kolo.png" Stretch="None"/>
        </Border>
    </StackPanel>
</Window>
