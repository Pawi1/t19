<Window x:Class="zad2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:zad2"
        mc:Ignorable="d"
        Title="Bilety" Height="225" Width="250">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="0.5*"/>
            <RowDefinition />
            <RowDefinition Height="0.5*"/>
            <RowDefinition Height="0.5*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <TextBlock Margin="5" VerticalAlignment="Center" HorizontalAlignment="Center">Liczba dni:</TextBlock>
        <TextBox x:Name="tbD" Grid.Column="1" Margin="5" Width="105" VerticalAlignment="Center" HorizontalAlignment="Center"></TextBox>
        <GroupBox Margin="5" Header="Rodzaj biletu" Grid.Column="0" Grid.Row="1">
            <StackPanel>
                <RadioButton x:Name="rbN" IsChecked="True">normalny</RadioButton>
                <RadioButton x:Name="rbU">ulgowy</RadioButton>
            </StackPanel>
        </GroupBox>
        <StackPanel Grid.Column="1" Grid.Row="1" Margin="5">
            <Label>Wybór strefy:</Label>
            <ComboBox x:Name="cb">
                <ComboBoxItem x:Name="cbA" IsSelected="True">A</ComboBoxItem>
                <ComboBoxItem x:Name="cbB" >B</ComboBoxItem>
                <ComboBoxItem x:Name="cbAB" >A+B</ComboBoxItem>
            </ComboBox>
        </StackPanel>
        <Button Grid.Row="2" Grid.ColumnSpan="2" Margin="5" Click="Button_Click" >
            Oblicz
        </Button>
        <TextBlock x:Name="tbP" Grid.ColumnSpan="2" Grid.Row="3">Podsumowanie: </TextBlock>
    </Grid>
</Window>
